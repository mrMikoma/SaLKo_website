{
  "annotations": {
    "list": []
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Next.js log rate by level",
      "description": "Log lines per minute from the Next.js app, stacked by level (detected_level). Red is error, amber warn, grey the rest. A quiet app can show nothing for hours: it writes only when something happens.",
      "datasource": "Loki",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (detected_level) (count_over_time({compose_service=\"nextjs\", environment=~\"$environment\"} | detected_level=~\"$level\" |~ \"(?i)${search:regex}\"[1m]))",
          "refId": "A",
          "legendFormat": "{{detected_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fatal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors and warnings, last 6 hours",
      "description": "Number of error and warn lines from the Next.js app in the last 6 hours, independent of the dashboard's time range.",
      "datasource": "Loki",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({compose_service=\"nextjs\", environment=~\"$environment\"} | detected_level=~\"error|fatal\" [6h]))",
          "refId": "A",
          "legendFormat": "errors",
          "instant": true,
          "queryType": "instant"
        },
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({compose_service=\"nextjs\", environment=~\"$environment\"} | detected_level=\"warn\" [6h]))",
          "refId": "B",
          "legendFormat": "warnings",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "warnings"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Top modules",
      "description": "Which parts of the app (the `module` field of the JSON records) wrote the most lines in the selected range.",
      "datasource": "Loki",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "topk(10, sum by (module) (count_over_time({compose_service=\"nextjs\", environment=~\"$environment\"} | detected_level=~\"$level\" | json | module != \"\" |~ \"(?i)${search:regex}\"[$__range])))",
          "refId": "A",
          "legendFormat": "{{module}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latest errors and warnings",
      "description": "The newest error and warn records of the Next.js app: message, module and the error. Failed requests have module `request`.",
      "datasource": "Loki",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{compose_service=\"nextjs\", environment=~\"$environment\"} | json | level=~\"error|warn|fatal\" |~ \"(?i)${search:regex}\"",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "id": true,
              "tsNs": true,
              "labelTypes": true
            },
            "indexByName": {
              "Time": 0,
              "level": 1,
              "module": 2,
              "msg": 3,
              "err": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Next.js logs",
      "description": "Every line of the Next.js app that matches the level and search filters above.",
      "datasource": "Loki",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{compose_service=\"nextjs\", environment=~\"$environment\"} | detected_level=~\"$level\" |~ \"(?i)${search:regex}\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Traefik requests per second by status class",
      "description": "Requests through Traefik per second, by status class (2xx-5xx), from its access log. Needs the access log (traefik/traefik.yaml) and a deployed Alloy.",
      "datasource": "Loki",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (status_class) (rate({compose_service=\"traefik\", status_class!=\"\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Traefik 4xx and 5xx requests",
      "description": "The newest requests Traefik answered with 4xx or 5xx: status, method, path (no query string), router and duration.",
      "datasource": "Loki",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{compose_service=\"traefik\", status_class=~\"4xx|5xx\"} | json",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "DownstreamStatus": true,
              "RequestMethod": true,
              "RequestPath": true,
              "RouterName": true,
              "Duration": true
            },
            "indexByName": {
              "Time": 0,
              "DownstreamStatus": 1,
              "RequestMethod": 2,
              "RequestPath": 3,
              "RouterName": 4,
              "Duration": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "All services' logs",
      "description": "Logs of the services chosen in the `service` filter (and the level and search filters), for Traefik, Postgres, Grafana and the rest.",
      "datasource": "Loki",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{compose_service=~\"$service\", environment=~\"$environment|\"} |~ \"(?i)${search:regex}\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Log Rate by Service",
      "description": "Log lines per minute per service, stacked.",
      "datasource": "Loki",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({compose_service=~\"$service\"}[1m])) by (compose_service)",
          "refId": "A",
          "legendFormat": "{{compose_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
