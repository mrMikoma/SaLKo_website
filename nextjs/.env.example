# Copy to .env and fill in. Local dev uses the postgres/ compose stack:
#   docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' salko-postgres
DATABASE_CONNECTION_STRING="postgresql://salko_app:<APP_DB_PASSWORD>@<postgres-host>:5432/salko"

# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Workspace client, restricted to savonlinnanlentokerho.fi)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
UMAMI_INTERNAL_URL="http://salko-umami:3000"
ALLOW_INDEXING="false"
# Logging (utilities/logger.ts, docs/LOGGING.md): the lowest level written,
# trace | debug | info | warn | error | fatal | silent (default debug here, info
# in production), and pretty (default here) or json (default in production)
# LOG_LEVEL="debug"
# LOG_FORMAT="pretty"
# Flight log sheet (utilities/flightSheetSource.ts): "google" reads a Google
# Sheet with the two variables below; "fixture" reads the synthetic
# e2e/fixtures/flight-sheet.json (the default under `bun dev` without Google).
# Locally, only ever the dev spreadsheet; setup in docs/FLIGHT_LOG_SETUP.md.
# The key is the service account's JSON key file, as is or in base64.
# FLIGHT_SHEET_SOURCE="fixture"
GOOGLE_SERVICE_ACCOUNT_KEY=""
FLIGHT_LOG_SPREADSHEET_ID=""
# Unfinished features (utilities/features.ts): on under `bun dev` unless set to "false"
# FEATURE_FLIGHT_LOG="true"
# Billing periods and invoices; needs the flight log too
# FEATURE_BILLING="true"
# Historiaa and Hallit, waiting for the club members' review
# FEATURE_PAGES_IN_REVIEW="true"
# The made-up flights button on /admin/lennot (utilities/sampleFlights.ts); never in prod
# FLIGHT_LOG_SAMPLE_DATA="true"

# Email (docs/MAIL_SETUP.md). Off unless MAIL_MODE is set: messages are only
# stored in email_outbox. "redirect" sends everything to MAIL_REDIRECT_TO
# (the dev environment); "send" mails the recipients (production only).
# MAIL_MODE="redirect"
# MAIL_REDIRECT_TO=""
# The club's one mail account, which sends everything, the OAuth client, and
# the account's token from `bun run mail:authorize <account>`
# MAIL_FROM=""
# MAIL_GMAIL_CLIENT_ID=""
# MAIL_GMAIL_CLIENT_SECRET=""
# MAIL_REFRESH_TOKEN=""

# Optional: existing accounts for e2e tests against a non-local database.
# Against a local database the tests create their own accounts.
# E2E_USER_EMAIL=""
# E2E_USER_PASSWORD=""
# E2E_ADMIN_EMAIL=""
# E2E_ADMIN_PASSWORD=""
