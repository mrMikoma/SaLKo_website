// Managed by Ansible (infra/ansible/roles/maintenance). Local changes are overwritten.
// Read after the distro's 50unattended-upgrades, which is left untouched.

// apt appends to list options across files, so a second file can only add
// origins. Clear the lists first to make this file the one that decides.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
{% for origin in maintenance_unattended_allowed_origins %}
	"{{ origin }}";
{% endfor %}
};

// Appended to the distro list. Docker Engine is only upgraded by a playbook run.
Unattended-Upgrade::Package-Blacklist {
{% for pattern in maintenance_unattended_package_blacklist %}
	"{{ pattern }}";
{% endfor %}
};

Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Reboots are handled by salko-reboot-if-required.timer.
Unattended-Upgrade::Automatic-Reboot "false";
