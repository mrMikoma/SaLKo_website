# Managed by Ansible (infra/ansible/roles/backup). Local changes are overwritten.
[Unit]
Description=SaLKo nightly off-site backup

[Timer]
OnCalendar={{ backup_on_calendar }} {{ backup_timezone }}
RandomizedDelaySec={{ backup_randomized_delay }}
# A night missed while the server was off runs after the next boot.
Persistent=true

[Install]
WantedBy=timers.target
