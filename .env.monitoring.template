# The monitoring stack's two env files. deploy-monitoring.yaml writes both on
# the hosts (monitoring/scripts/deploy-{server,agent}.sh); this is what is in
# them, for running a stack by hand. See monitoring/README.md.

# --- .env.monitoring-server, next to docker-compose.monitoring.yaml ---------
NAME_PREFIX=salko
# Grafana's admin password (secret GRAFANA_ADMIN_PASSWORD)
GRAFANA_ADMIN_PASSWORD=changeme
# The address the gateway (:3101) and Grafana (:3000) are published on:
# 127.0.0.1 next to the apps, the host's private address on a host of its own
MONITORING_BIND_ADDR=127.0.0.1
MONITORING_DATA_DIR=/home/salko/monitoring

# --- .env.monitoring, next to docker-compose.monitoring-agent.yaml ----------
NAME_PREFIX=salko
MONITORING_DATA_DIR=/home/salko/monitoring
# This host's name on its metrics and logs
AGENT_HOST=salko0
# The server's gateway: over Docker's network next to the server, otherwise
# http://<server's private address>:3101
MONITORING_PUSH_URL=http://monitoring-gateway:8080
MONITORING_PUSH_USER=agent
# Made on the server, in $MONITORING_DATA_DIR/gateway/push-password
MONITORING_PUSH_PASSWORD=changeme
# pgAdmin's login password
GRAFANA_ADMIN_PASSWORD=changeme
# The exporters log in as the databases' superuser, password URL-encoded.
# The dev deploy writes the dev one, the monitoring and prod deploys the prod one.
DEV_POSTGRES_EXPORTER_DSN=postgresql://salko_admin:PASSWORD@salko-postgres-dev:5432/salko?sslmode=disable
PROD_POSTGRES_EXPORTER_DSN=postgresql://salko_admin:PASSWORD@salko-postgres-prod:5432/salko?sslmode=disable
# Umami's database and secret
DATABASE_URL=postgresql://umami_app:PASSWORD@salko-postgres-prod:5432/umami
APP_SECRET=changeme
