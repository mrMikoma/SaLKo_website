# Copy to .env (read by docker-compose.yaml and the init/ scripts).
# PostgreSQL superuser (created by the postgres image on first start)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=salko

# Application user (init/00-create-app-user.sql); nextjs/.env connects as this user
APP_DB_USER=salko_app
APP_DB_PASSWORD=

# Umami analytics database (init/06-create-umami-db.sql)
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=
